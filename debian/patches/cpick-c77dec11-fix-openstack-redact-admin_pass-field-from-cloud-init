+    @mock.patch(M_PATH + "on_first_boot")
+    def test_get_data_redacts_admin_pass_in_public_instance_data(
+        self, m_on_first_boot, paths, tmp_path
+    ):
+        """admin_pass from config-drive is redacted from instance-data.json.
+
+        Nova writes the admin password to meta_data.json on the config drive
+        of instances launched with --use-config-drive and --admin-pass. That
+        password must be redacted from the world-readable instance-data.json
+        while remaining in the root-readable instance-data-sensitive.json.
+        """
+        admin_pass = "sekrit-admin-pass"
+        ostack_meta = copy(OSTACK_META)
+        ostack_meta["admin_pass"] = admin_pass
+        files = copy(CFG_DRIVE_FILES_V2)
+        for version in ("2012-08-10", "2015-10-15", "latest"):
+            files["openstack/%s/meta_data.json" % version] = json.dumps(
+                ostack_meta
+            )
+        populate_dir(str(tmp_path), files)
+        cfg_ds = ds.DataSourceConfigDrive(settings.CFG_BUILTIN, None, paths)
+        cfg_ds.seed_dir = str(tmp_path)
+        assert cfg_ds.get_data()
+        assert admin_pass == cfg_ds.metadata["admin_pass"]
+
+        public_json = util.load_json(
+            util.load_text_file(paths.get_runpath("instance_data"))
+        )
+        assert "ds/meta_data/admin_pass" in public_json["sensitive_keys"]
+        assert (
+            REDACT_SENSITIVE_VALUE
+            == public_json["ds"]["meta_data"]["admin_pass"]
+        )
+        sensitive_json = util.load_json(
+            util.load_text_file(paths.get_runpath("instance_data_sensitive"))
+        )
+        assert admin_pass == sensitive_json["ds"]["meta_data"]["admin_pass"]
+
 
